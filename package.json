{
  "name": "ms-monster-global-corporate-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "react-router dev --port=3000 --host=0.0.0.0",
    "build": "npm run generate:assets && react-router build && tsx scripts/generate-public-files.ts && npm run verify:build",
    "preview": "vite preview --outDir build/client",
    "clean": "rm -rf dist server.js",
    "generate:assets": "tsx scripts/generate-brand-assets.ts",
    "verify:build": "tsx scripts/verify-build.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-router/node": "^7.18.1",
    "@tailwindcss/vite": "^4.1.14",
    "isbot": "^5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router": "^7.18.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@react-router/dev": "^7.18.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/fontkit": "2.0.9",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "fontkit": "2.0.4",
    "jsdom": "^30.0.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
